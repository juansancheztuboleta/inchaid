{
  "expo": {
    "name": "inchaid",
    "slug": "inchaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "inchaid",
      "tixngo"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.inchaid",
      "infoPlist": {
        "NSContactsUsageDescription": "Necesitamos acceso a tus contactos para elegir a quién transferir tus boletas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.inchaid"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-short-cxx-dir",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.6",
            "useFrameworks": "static",
            "extraPods": [
              {
                "name": "Tixngo",
                "path": "/Volumes/Luxwise/Tuboleta/inchaId/sdk/ios"
              },
              {
                "name": "Tixngo-debug",
                "path": "/Volumes/Luxwise/Tuboleta/inchaId/sdk/ios",
                "configurations": [
                  "Debug"
                ]
              },
              {
                "name": "Tixngo-release",
                "path": "/Volumes/Luxwise/Tuboleta/inchaId/sdk/ios",
                "configurations": [
                  "Release"
                ]
              }
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
